<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FAF8F5</color>
    <color name="sun">#D4705F</color>
    <style name="Theme.Diary" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <style name="Theme.Diary.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_sun</item>
        <item name="postSplashScreenTheme">@style/Theme.Diary</item>
    </style>
</resources>
